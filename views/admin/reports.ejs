<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Moderation & Reports - Learnify</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet" />
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#00d9b1",
                        "background-light": "#F9FAFB",
                        "background-dark": "#111827",
                        "surface-light": "#FFFFFF",
                        "surface-dark": "#1F2937",
                    },
                    fontFamily: {
                        display: ["Inter", "sans-serif"],
                    },
                },
            },
        };
    </script>
</head>

<body
    class="font-display bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen lg:h-screen lg:overflow-hidden flex flex-col lg:flex-row">

    <%- include('../partials/admin-sidebar') %>

        <main class="flex-1 ml-0 lg:ml-64 p-4 sm:p-6 lg:p-8 pt-20 lg:pt-8 min-h-screen lg:h-screen lg:overflow-y-auto">
            <header class="flex justify-between items-center mb-8">
                <div>
                    <h2 class="text-3xl font-bold text-slate-800 dark:text-white">Moderation & Reports</h2>
                    <p class="text-slate-500 dark:text-slate-400 mt-1">Review flagged courses and manage compliance</p>
                </div>
                <div class="flex items-center gap-3">
                    <button
                        class="p-2 bg-surface-light dark:bg-surface-dark border border-slate-200 dark:border-slate-800 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
                        onclick="document.documentElement.classList.toggle('dark')">
                        <span class="material-icons-outlined text-slate-600 dark:text-slate-300">dark_mode</span>
                    </button>
                </div>
            </header>

            <!-- Reports Table -->
            <div
                class="bg-surface-light dark:bg-surface-dark rounded-xl border border-slate-200 dark:border-slate-800 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-700">
                            <tr>
                                <th
                                    class="px-6 py-4 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider">
                                    Flagged Course</th>
                                <th
                                    class="px-6 py-4 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider">
                                    Report Count</th>
                                <th
                                    class="px-6 py-4 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider">
                                    Reported By</th>
                                <th
                                    class="px-6 py-4 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider">
                                    Reason</th>
                                <th
                                    class="px-6 py-4 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider">
                                    Listing Status</th>
                                <th
                                    class="px-6 py-4 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider">
                                    Report Status</th>
                                <th
                                    class="px-6 py-4 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider">
                                    Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                            <% if (reports && reports.length> 0) { %>
                                <% reports.forEach(report=> { %>
                                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                                        <td class="px-6 py-4">
                                            <% if (report.courseId) { %>
                                                <div class="font-semibold text-slate-800 dark:text-white">
                                                    <%= report.courseId.title %>
                                                </div>
                                                <div class="text-xs text-slate-500">
                                                    Tutor: <%= report.courseId.tutor?.fullName || 'Unknown' %>
                                                </div>
                                            <% } else { %>
                                                <span class="text-sm text-slate-400 italic">Deleted Course</span>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400">
                                                <%= report.courseId?.reportCount || 0 %> flags
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="text-sm text-slate-700 dark:text-slate-300">
                                                <%= report.userId?.fullName || 'Anonymous' %>
                                            </div>
                                            <div class="text-xs text-slate-500">
                                                <%= report.userId?.email || '' %>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="text-sm font-medium text-slate-800 dark:text-slate-200">
                                                <%= report.reasonType %>
                                            </span>
                                            <% if (report.customReason) { %>
                                                <p class="text-xs text-slate-500 italic mt-1 bg-slate-50 dark:bg-slate-800/50 p-2 rounded">
                                                    "<%= report.customReason %>"
                                                </p>
                                            <% } %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="px-2.5 py-1 text-xs font-medium rounded-full <%= report.courseId?.isListed !== false ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400' : 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400' %>">
                                                <%= report.courseId?.isListed !== false ? 'Listed' : 'Unlisted' %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <span class="px-2.5 py-1 text-xs font-medium rounded-full <%= report.status === 'Pending' ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400' : report.status === 'Reviewed' ? 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400' : 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400' %>">
                                                <%= report.status %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <div class="flex items-center gap-2">
                                                <% if (report.courseId) { %>
                                                    <button onclick="window.location.href='/admin/course/<%= report.courseId._id %>'"
                                                        class="p-1.5 text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg transition-colors"
                                                        title="View & Review Lessons">
                                                        <span class="material-icons-outlined text-[18px]">visibility</span>
                                                    </button>
                                                    <button onclick="toggleModeration('<%= report.courseId._id %>', <%= report.courseId.isListed !== false %>)"
                                                        class="p-1.5 text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors"
                                                        title="Moderate Listing">
                                                        <span class="material-icons-outlined text-[18px]">gavel</span>
                                                    </button>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="px-6 py-12 text-center">
                                        <span class="material-icons-outlined text-6xl text-slate-300 dark:text-slate-600 mb-4 block">assignment_turned_in</span>
                                        <p class="text-slate-500 dark:text-slate-400 text-lg">No reports found</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Pagination -->
            <% if (pagination.totalPages> 1) { %>
                <div class="flex justify-between items-center mt-6">
                    <p class="text-sm text-slate-500 dark:text-slate-400">
                        Showing <%= ((pagination.currentPage - 1) * 10) + 1 %> to <%= Math.min(pagination.currentPage * 10, pagination.totalReports) %> of <%= pagination.totalReports %> reports
                    </p>
                    <div class="flex items-center gap-2">
                        <% if (pagination.hasPrev) { %>
                            <a href="?page=<%= pagination.prevPage %>"
                                class="w-9 h-9 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-800 bg-surface-light dark:bg-surface-dark hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                                <span class="material-icons-outlined text-slate-600 dark:text-slate-400">chevron_left</span>
                            </a>
                        <% } %>

                        <% for (let i=1; i <=pagination.totalPages; i++) { %>
                            <% if (i===pagination.currentPage) { %>
                                <span class="w-9 h-9 flex items-center justify-center rounded-lg bg-primary text-white font-medium text-sm">
                                    <%= i %>
                                </span>
                            <% } else { %>
                                <a href="?page=<%= i %>"
                                    class="w-9 h-9 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-800 bg-surface-light dark:bg-surface-dark hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors text-sm font-medium">
                                    <%= i %>
                                </a>
                            <% } %>
                        <% } %>

                        <% if (pagination.hasNext) { %>
                            <a href="?page=<%= pagination.nextPage %>"
                                class="w-9 h-9 flex items-center justify-center rounded-lg border border-slate-200 dark:border-slate-800 bg-surface-light dark:bg-surface-dark hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
                                <span class="material-icons-outlined text-slate-600 dark:text-slate-400">chevron_right</span>
                            </a>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            async function toggleModeration(courseId, isListed) {
                if (isListed) {
                    // Prompt for unlisting reason
                    const { value: reason } = await Swal.fire({
                        title: 'Unlist Flagged Course',
                        input: 'textarea',
                        inputPlaceholder: 'Enter the reason for unlisting this course...',
                        inputLabel: 'Unlisting Reason (shown to tutor and enrolled students)',
                        inputAttributes: {
                            'aria-label': 'Type your reason here'
                        },
                        showCancelButton: true,
                        confirmButtonColor: '#ef4444',
                        cancelButtonColor: '#6b7280',
                        confirmButtonText: 'Unlist Course',
                        cancelButtonText: 'Cancel',
                        inputValidator: (value) => {
                            if (!value) {
                                return 'You must enter a reason to unlist!'
                            }
                        }
                    });

                    if (reason) {
                        submitModerationStatus(courseId, false, reason);
                    }
                } else {
                    // Re-list course confirmation
                    Swal.fire({
                        title: 'Relist Course?',
                        text: 'This will list the course back on the public catalog and search results.',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#00d9b1',
                        cancelButtonColor: '#6b7280',
                        confirmButtonText: 'Yes, Relist Course',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            submitModerationStatus(courseId, true, '');
                        }
                    });
                }
            }

            async function submitModerationStatus(courseId, isListed, unlistingReason) {
                try {
                    const response = await fetch(`/admin/course/${courseId}/moderation`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ isListed, unlistingReason })
                    });
                    const data = await response.json();
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: data.message,
                            confirmButtonColor: '#00d9b1'
                        }).then(() => location.reload());
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error!',
                            text: data.message,
                            confirmButtonColor: '#00d9b1'
                        });
                    }
                } catch (error) {
                    console.error('Moderation status update error:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: 'Something went wrong while updating moderation status.',
                        confirmButtonColor: '#00d9b1'
                    });
                }
            }
        </script>
        <script src="/js/admin-session.js"></script>
</body>

</html>
